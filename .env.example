# ─── Public site config ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://get.installpros.co.uk
NEXT_PUBLIC_WHATSAPP_NUMBER=447000000000          # E.164 without the +
NEXT_PUBLIC_CONTACT_PHONE=+441234567890
NEXT_PUBLIC_CONTACT_EMAIL=hello@installpros.co.uk

# ─── PostHog (product analytics, Phase 4) ─────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Dashboard funnel page (server-side queries; Settings → Personal API keys):
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ─── GA4 + GTM + Google Ads (Phase 3) ─────────────────────────────────
# gtag only loads when one of these is set. Without it NO Google Ads
# conversion can fire, whatever the label below says.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Google Ads conversion target, "AW-<conversion id>/<label>". Both halves come
# from the Google Ads account (Goals → Conversions). Fired on the
# /upload-property-images step, which both funnels redirect to after submit.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# ─── Property intelligence (lead enrichment + scoring) ────────────────
# All optional — enrichment degrades gracefully without them.
# postcodes.io + Land Registry need no keys.
OFCOM_API_KEY=                     # register at https://api.ofcom.org.uk
HOMEDATA_API_KEY=                  # https://homedata.co.uk — /starlink-installation coverage message (server-only)
PROPALT_API_KEY=                   # https://propalt.ai — reserve source; activate via Settings → APIs toggle
GOOGLE_MAPS_API_KEY=               # Static Maps API — satellite view on lead cards (server-only)
# PROPALT_API_BASE=https://api.propalt.io
EPC_BEARER_TOKEN=                  # from https://get-energy-performance-data.communities.gov.uk (My account)
# Legacy EPC service (retired May 2026) — only if you have old credentials:
EPC_API_EMAIL=
EPC_API_KEY=

# ─── Google Places + reviews (server-only) ────────────────────────────
# Address autocomplete on /starlink-installation. Falls back to
# GOOGLE_MAPS_API_KEY. Needs "Places API (New)" enabled + billing, and the
# key's HTTP restrictions must allow the production domain.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=                   # the Google listing, for the reviews block

# ─── Supabase (Phase 2 auth + lead storage) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx        # server-only, never expose to client

# ─── Outbound lead webhooks ───────────────────────────────────────────
# Zero-config destination: paste a Zapier / Make catch-hook URL here and every
# lead is forwarded to it. Endpoints added in Dashboard → Settings → Webhooks
# work alongside this and don't need it set.
LEAD_WEBHOOK_URL=
# Which events the env destination receives. Default: lead.enriched only
# (it carries the 1-10 score). Use "lead.created,lead.enriched" for both.
LEAD_WEBHOOK_EVENTS=
# Optional. When set, requests carry an X-InstallPros-Signature HMAC so the
# receiver can verify the payload came from us. Zapier ignores it.
LEAD_WEBHOOK_SECRET=
